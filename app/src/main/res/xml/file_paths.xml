<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- DownloadController's folder: getExternalFilesDir(DIRECTORY_DOWNLOADS),
         which is Android/data/app.ypn.browser/files/Download/ -->
    <external-files-path name="downloads" path="Download/" />
    <!-- Fallback folder inside filesDir, used if external files are unavailable -->
    <files-path name="internal_downloads" path="downloads/" />
</paths>
