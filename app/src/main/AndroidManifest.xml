<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 3 fix (v1.0.3): ConnectivityManager.requestNetwork — used
         to bring up the cellular network next to Wi-Fi for dual-network
         downloads — is refused with a SecurityException unless the app
         holds CHANGE_NETWORK_STATE (a normal, auto-granted permission). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Phase 2: the embedded Open SSTP Client runs as a foreground
         VPN service (specialUse type, as in upstream OSC). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 3: downloads run under a dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YPNBrowser">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Open SSTP Client core (kittoku.osc, MIT — see
             third_party/Open-SSTP-Client-LICENSE). Mirrors upstream
             OSC's own manifest entries for these services. -->
        <service
            android:name="kittoku.osc.service.SstpVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name="kittoku.osc.service.SstpTileService"
            android:exported="true"
            android:icon="@drawable/ic_baseline_vpn_lock_24"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Phase 3: foreground shell for the download manager. -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serves completed downloads to viewer apps (Open button). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.ypn.browser.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
